# Freshifyz native Windows development. Start scripts/ssh-tunnel.ps1 first.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# VPS-native/Linux Compose: use PGPORT=55432.
PGHOST=127.0.0.1
PGPORT=65432
PGDATABASE=freshifyz
PGUSER=freshifyz_app
# Generate 48 random bytes encoded as base64url. Do not use owner credentials.
PGPASSWORD=REPLACE_ME_WITH_A_GENERATED_DATABASE_PASSWORD

# disable is accepted ONLY for literal loopback (SSH tunnel or same host).
# Other hosts require verify-full, a trusted CA, and a matching certificate.
PGSSLMODE=disable
# PGSSLROOTCERT=/absolute/path/to/postgresql-ca.crt
# PGSSL_SERVER_NAME=database.example.com
PGPOOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=5000

# Generate an independent 64 random bytes encoded as hex (128 characters).
JWT_SECRET=REPLACE_ME_WITH_AN_INDEPENDENT_RANDOM_JWT_SECRET
JWT_ISSUER=freshifyz
JWT_AUDIENCE=freshifyz-api
JWT_EXPIRES_IN_SECONDS=900

# Comma-separated exact origins, without trailing slashes. Empty denies browser
# cross-origin access; native mobile clients and server requests have no Origin.
CORS_ORIGINS=
BODY_LIMIT_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Set only for a known reverse proxy chain; never use an unrestricted boolean.
TRUST_PROXY_HOPS=0
