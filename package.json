{
  "name": "freshifyz",
  "version": "1.0.0",
  "private": true,
  "description": "Freshifyz Express and PostgreSQL starter",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev-server": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "prod-server": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:smoke": "npm run build && node scripts/smoke-test.cjs",
    "db:check": "tsx scripts/check-database.ts",
    "db:verify": "tsx scripts/verify-database.ts"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": { "js-yaml": "^4.1.1" }
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
